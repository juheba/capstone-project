{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Collection",
  "description": "A collection of a user.",
  "type": "object",
  "required": [
    "collectionId",
    "userId",
    "lastModified",
    "createdAt",
    "name",
    "visibility"
  ],
  "properties": {
    "collectionId": {
      "type": "string",
      "format": "uuid"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "lastModified": {
      "type": "string",
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "name": {
      "description": "The name of the collection (e.g., \"Science Fiction Books\", \"Marvel Movies\").",
      "type": "string",
      "minLength": 1
    },
    "description": {
      "description": "A brief description of the collection.",
      "type": "string",
      "minLength": 1
    },
    "visibility": {
      "description": "Settings to control who can view the collection (public, private, shared with specific users).",
      "type": "string",
      "enum": [
        "PRIVATE",
        "PUBLIC"
      ]
    }
  },
  "additionalProperties": false
}