{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "CollectionResponse",
  "description": "A collection of a user.",
  "type": "object",
  "properties": {
    "collection": {
      "type": "object",
      "properties": {
        "collectionId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "lastModified": {
          "type": "string",
          "format": "date"
        },
        "createdAt": {
          "type": "string",
          "format": "date"
        },
        "name": {
          "description": "The name of the collection (e.g., \"Science Fiction Books\", \"Marvel Movies\").",
          "type": "string",
          "minLength": 1
        },
        "description": {
          "description": "A brief description of the collection.",
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "description": "Settings to control who can view the collection (public, private, shared with specific users).",
          "type": "string",
          "enum": [
            "PRIVATE",
            "PUBLIC"
          ]
        }
      }
    }
  },
  "additionalProperties": false
}